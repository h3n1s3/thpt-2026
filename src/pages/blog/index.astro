---
import Layout from '../../layouts/Layout.astro';
const base=import.meta.env.BASE_URL;
const posts=Object.values(import.meta.glob('./*.md',{eager:true})).sort((a:any,b:any)=>new Date(b.frontmatter.date).getTime()-new Date(a.frontmatter.date).getTime()) as any[];
const tags=[...new Set(posts.flatMap(p=>p.frontmatter.tags))];
---
<Layout title="Field notes — Security Research" description="Ghi chép về pentest, nghiên cứu lỗ hổng và công bố CVE." active="blog"><section class="blog-intro"><div class="eyebrow">THE RESEARCH NOTEBOOK</div><h1>Field notes<span class="accent">.</span></h1><p class="section-sub">Từ quan sát ban đầu đến một kết luận có thể kiểm chứng.</p><p class="sample-note">Các bài dưới đây là nội dung mẫu để minh họa blog Markdown.</p></section><label for="search" class="eyebrow">TÌM TRONG GHI CHÉP</label><input class="search" id="search" type="search" placeholder="Tìm theo tiêu đề, nội dung hoặc tag…"/><div class="filters" aria-label="Lọc theo chủ đề"><button class="active" data-tag="all" aria-pressed="true">Tất cả</button>{tags.map(t=><button data-tag={t} aria-pressed="false">{t}</button>)}</div><p id="result-count" class="sample-note" role="status">{posts.length} bài viết</p><div class="post-list">{posts.map(p=><a class="post-row" href={p.url} data-post data-tags={JSON.stringify(p.frontmatter.tags)} data-search={`${p.frontmatter.title} ${p.frontmatter.description} ${p.frontmatter.tags.join(' ')} ${p.rawContent()}`}><div class="post-date">{new Date(p.frontmatter.date).toLocaleDateString('vi-VN')}<br/>{Math.max(1,Math.ceil(p.rawContent().split(/\s+/).length/220))} phút đọc</div><div><h3>{p.frontmatter.title}<span>↗</span></h3><p>{p.frontmatter.description}</p><div class="tags">{p.frontmatter.tags.map((t:string)=><span>{t}</span>)}</div><p class="sample-note">Cập nhật {new Date(p.frontmatter.updated||p.frontmatter.date).toLocaleDateString('vi-VN')}</p></div></a>)}</div><p id="no-results" hidden>Không tìm thấy bài viết. Thử từ khóa hoặc chủ đề khác.</p><div class="section"><a href={`${base}rss.xml`}>Theo dõi bài mới qua RSS ↗</a></div></Layout>
<script>let tag='all';const input=document.querySelector<HTMLInputElement>('#search')!;const normalize=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').toLowerCase();function filter(){let count=0;document.querySelectorAll<HTMLElement>('[data-post]').forEach(el=>{const visible=(tag==='all'||JSON.parse(el.dataset.tags!).includes(tag))&&normalize(el.dataset.search!).includes(normalize(input.value.trim()));el.hidden=!visible;if(visible)count++});document.querySelector('#result-count')!.textContent=`${count} bài viết`;document.querySelector<HTMLElement>('#no-results')!.hidden=count!==0;}input.addEventListener('input',filter);document.querySelectorAll<HTMLButtonElement>('[data-tag]').forEach(button=>button.addEventListener('click',()=>{tag=button.dataset.tag!;document.querySelectorAll<HTMLButtonElement>('[data-tag]').forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button))});filter()}));</script>
