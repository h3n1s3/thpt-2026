import Layout from '../layouts/Layout.astro';
---
<Layout title="CV — Security Research"><section class="blog-intro"><div class="eyebrow">CURRICULUM VITAE · BẢN NHÁP</div><h1>Your Name</h1><p class="role">Security Researcher · Aspiring Red Teamer</p><button class="print button">Lưu CV thành PDF ↓</button><p class="sample-note">Chọn “Save as PDF” trong cửa sổ in. Hồ sơ chưa có thông tin cá nhân đầy đủ.</p></section><section class="section"><h2>Định hướng</h2><p>Phát triển theo hướng Red Team / Penetration Testing; quan tâm đến nghiên cứu lỗ hổng và phân tích nguyên nhân gốc rễ.</p></section><section class="section"><h2>Vulnerability research</h2><p>Hai báo cáo đang chờ vendor vá, chưa được cấp CVE ID: Broken Authentication (điểm CVSS cung cấp: 9.8) và Privilege Escalation qua chuỗi CSRF/account linking (điểm CVSS cung cấp: 8.0). Điểm số chưa được xác minh độc lập. Chi tiết kỹ thuật chưa công bố.</p></section><section class="section"><h2>Kinh nghiệm & kỹ năng</h2><p>Chờ thông tin kinh nghiệm và kỹ năng đã được xác nhận.</p></section><section class="section"><h2>Học vấn & chứng chỉ</h2><p>Chờ bổ sung trường, chương trình học và chứng chỉ đã đạt được.</p></section><section class="section"><h2>Liên hệ</h2><p>Chờ email, GitHub và LinkedIn.</p></section></Layout><script>document.querySelector('.print')?.addEventListener('click',()=>window.print());</script><style is:global>@media print{html[data-theme],:root{--bg:white;--text:#222;--muted:#555;--line:#ddd;--accent:#71323a}header,footer,.print,.skip,.sample-note{display:none!important}main{max-width:none;padding:0}.blog-intro{padding:0 0 20px}.section{padding:18px 0;break-inside:avoid}body{font-size:12pt}h1{font-size:32pt}h2{font-size:20pt}@page{size:A4;margin:18mm}}</style>

