---
import Layout from './Layout.astro';
const {frontmatter}=Astro.props;
const headings=Astro.props.headings.filter((h:any)=>h.depth===2);
const source=Object.values(import.meta.glob('../pages/blog/*.md',{eager:true})).find((p:any)=>p.frontmatter.title===frontmatter.title) as any;
const minutes=Math.max(1,Math.ceil(source.rawContent().split(/\s+/).length/220));
const formatted=(d:string)=>new Date(d).toLocaleDateString('vi-VN');
---
<Layout title={`${frontmatter.title} — Security Field Notes`} description={frontmatter.description} active="article"><div class="article-header"><a class="back" href="/blog/">← Tất cả bài viết</a><h1>{frontmatter.title}</h1><p class="section-sub">{frontmatter.description}</p><div class="tags">{frontmatter.tags.map((t:string)=><span>{t}</span>)}</div><p class="article-meta">{formatted(frontmatter.date)} · {minutes} phút đọc · Cập nhật {formatted(frontmatter.updated||frontmatter.date)}</p><p class="draft-banner">Bài viết minh họa cho blog, không phải báo cáo về CVE hoặc thành tích của chủ trang.</p>{frontmatter.cover && <img src={frontmatter.cover} alt={frontmatter.coverAlt||frontmatter.title} width="720" height="360" style="max-width:100%;height:auto"/>}<details class="toc" open><summary>Mục lục</summary>{headings.map((h:any)=><a href={`#${h.slug}`}>{h.text}</a>)}</details></div><article class="article-content"><slot/></article><div class="share"><button id="copy-link">Sao chép liên kết</button><a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(new URL(Astro.url.pathname,Astro.site).href)}&text=${encodeURIComponent(frontmatter.title)}`} target="_blank" rel="noopener noreferrer">Chia sẻ trên X ↗</a><span id="share-status" role="status"></span></div><script>document.getElementById('copy-link')?.addEventListener('click',async()=>{const status=document.getElementById('share-status')!;try{await navigator.clipboard.writeText(location.href);status.textContent='Đã sao chép'}catch{status.textContent='Hãy sao chép URL trên thanh địa chỉ.'}});</script></Layout>
